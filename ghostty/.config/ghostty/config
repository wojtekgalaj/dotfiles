font-size = 16

window-decoration = true
window-padding-x = 0
window-padding-y = 0
window-padding-color = extend

fullscreen = true

confirm-close-surface = false

unfocused-split-opacity=0.5

theme = dark:catppuccin frappe,light:catppuccin latte

keybind = global:super+j=toggle_quick_terminal
keybind = ctrl+s>l=new_split:right
keybind = ctrl+s>j=new_split:down
keybind = ctrl+s>h=new_split:left
keybind = ctrl+s>k=new_split:up
keybind = ctrl+s>f=toggle_split_zoom
keybind = ctrl+m>l=goto_split:right
keybind = ctrl+m>j=goto_split:down
keybind = ctrl+m>h=goto_split:left
keybind = ctrl+m>k=goto_split:up
keybind = ctrl+t>n=new_tab

